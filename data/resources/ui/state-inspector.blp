using Gtk 4.0;
using Adw 1;

template $ReefgraphStateInspector: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;
    vhomogeneous: false;

    StackPage {
      name: "diagram";

      child: Adw.PreferencesPage {
        Adw.PreferencesGroup {
          title: _("State Diagram");
          description: _("Drag from a state's handles to add a transition. Double-click a state or transition to edit its text.");

          Adw.ComboRow direction_row {
            title: _("Direction");
          }

          Adw.ActionRow {
            title: _("Auto Layout");
            subtitle: _("Discard manual positions");
            activatable-widget: layout_button;

            [suffix]
            Button layout_button {
              label: _("Arrange");
              valign: center;
            }
          }
        }
      };
    }

    StackPage {
      name: "state";

      child: Adw.PreferencesPage {
        Adw.PreferencesGroup state_group {
          Adw.EntryRow state_name_row {
            title: _("Name");
            show-apply-button: true;
          }

          Adw.EntryRow state_label_row {
            title: _("Description");
            show-apply-button: true;
          }

          Adw.ComboRow state_kind_row {
            title: _("Type");
          }
        }

        Adw.PreferencesGroup {
          Button delete_state_button {
            label: _("Delete State");
            halign: center;

            styles [
              "destructive-action",
              "pill",
            ]
          }
        }
      };
    }

    StackPage {
      name: "transition";

      child: Adw.PreferencesPage {
        Adw.PreferencesGroup {
          title: _("Transition");

          Adw.EntryRow transition_label_row {
            title: _("Label");
            show-apply-button: true;
          }

          Adw.ComboRow transition_from_row {
            title: _("From");
          }

          Adw.ComboRow transition_to_row {
            title: _("To");
          }
        }

        Adw.PreferencesGroup {
          Button delete_transition_button {
            label: _("Delete Transition");
            halign: center;

            styles [
              "destructive-action",
              "pill",
            ]
          }
        }
      };
    }
  };
}
