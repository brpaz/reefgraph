using Gtk 4.0;
using Adw 1;

template $ReefgraphPalette: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: FlowBox flowbox {
      valign: start;
      homogeneous: true;
      selection-mode: none;
      min-children-per-line: 2;
      max-children-per-line: 3;
      row-spacing: 6;
      column-spacing: 6;
      margin-top: 6;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;
    };
  };
}
