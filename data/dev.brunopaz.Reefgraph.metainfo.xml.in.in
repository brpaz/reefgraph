<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0</metadata_license>
  <project_license>MIT</project_license>
  <name>Reefgraph</name>
  <summary>Draw Mermaid diagrams</summary>
  <description>
    <p>
      Draw flowcharts, sequence, state, class, entity relationship, C4 and use case
      diagrams and mindmaps by dragging shapes on a canvas, while Reefgraph keeps the
      Mermaid source in sync next to it.
    </p>
    <p>
      Files stay plain Mermaid, so they render anywhere Mermaid does. Diagrams inside
      Markdown documents can be edited in place, and images can be exported as SVG or PNG.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <!-- FIXME Replace this placeholder screenshot URL with a project screenshot. -->
      <image>https://example.com/screenshot.png</image>
      <caption>Main window</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/brpaz/reefgraph</url>
  <url type="bugtracker">https://github.com/brpaz/reefgraph/issues</url>
  <url type="vcs-browser">https://github.com/brpaz/reefgraph</url>
  <keywords>
    <keyword>mermaid</keyword>
    <keyword>diagram</keyword>
    <keyword>flowchart</keyword>
    <keyword>uml</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" date="2019-07-11" />
  </releases>
  <developer id="dev.brunopaz">
    <name translate="no">Bruno Paz</name>
  </developer>
  <!--
    Branding colors:
    https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>
  <update_contact>noreply@example.com</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
